<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/DialogSectionLabel"
        android:text="@string/settings_size" />

    <RadioGroup
        android:id="@+id/rg_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/size_9" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/size_13" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/size_19" />
    </RadioGroup>

    <TextView
        style="@style/DialogSectionLabel"
        android:text="@string/settings_color" />

    <RadioGroup
        android:id="@+id/rg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/color_black" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/color_white" />
    </RadioGroup>

    <TextView
        style="@style/DialogSectionLabel"
        android:text="@string/settings_level" />

    <RadioGroup
        android:id="@+id/rg_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/level_1" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/level_2" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/level_3" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/level_4" />

        <RadioButton
            style="@style/SegmentButton"
            android:text="@string/level_5" />
    </RadioGroup>

    <TextView
        android:id="@+id/level_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_accent"
        android:stateListAnimator="@null"
        android:text="@string/settings_start"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_cancel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="@string/settings_cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
